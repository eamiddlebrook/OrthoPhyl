Bootstrap: docker
From: mambaorg/micromamba

%labels
AUTHOR earlm@lanl.gov

%files
    # CheckM2's DIAMOND reference DB (~2.9 GB) is staged from a pre-downloaded
    #   HOST copy instead of `checkm2 database --download` -- avoids a ~2.9 GB
    #   network fetch on every build. REQUIRED build-arg, no fallback: build
    #   with e.g.
    #     singularity build --build-arg checkm2_db_path=/home/user/databases/CheckM2_database/uniref100.KO.1.dmnd OrthoPhyl.sif Singularity.OP.v3.3.recipe
    #   Staged flat to /opt/ -- NOT the final /opt/checkm2_db/CheckM2_database/
    #   layout -- since %files runs before any %post and the target directory
    #   doesn't exist yet; the %post step below moves it into place after
    #   hashing it against checkm2's OWN bundled version-hash manifest and
    #   failing the build if it doesn't match a known DIAMONDDB entry -- so a
    #   stale/wrong/corrupt local copy is caught here, not silently used at
    #   runtime.
    {{ checkm2_db_path }} /opt/uniref100.KO.1.dmnd.staged

%post
    # save when the container was built
    NOW=`date`
    echo "export NOW=\"${NOW}\"" >> $SINGULARITY_ENVIRONMENT

    apt-get update
    apt-get install -y build-essential git
    apt-get install -y python3 pip libgl1
    apt-get install -y wget zip bc procps
    apt-get install -y patchelf
    # maven + default-jdk: build-time only, used below to `mvn package` VIGOR4
    #   from source (not a conda/bioconda package -- confirmed no bioconda/
    #   conda-forge "vigor*" package exists). Runtime execution instead uses
    #   the viral_annot env's own openjdk (see control_file.paths'
    #   viral_env_run), so this apt JDK is not referenced after the build.
    apt-get install -y maven default-jdk
    apt-get clean

%post
    # instal conda and conda packages
    # python=3.12 pinned to match orthophyl_env.2.2.1.yml's dev env -- ete3's
    #   webplugin submodule (imported unconditionally by ete3/__init__.py) does
    #   `import cgi`, which was removed from the stdlib in Python 3.13 (PEP 594).
    #   Without this pin, micromamba resolves whatever the latest Python is at
    #   build time, silently breaking every `import ete3` in the pipeline.
    micromamba install --yes --name base --channel bioconda --channel conda-forge python=3.12 prodigal orthofinder=2.5.4 bbmap=39.01 fasttree hmmer mash prodigal ete3 raxml trimal r-essentials scipy iqtree pytest matplotlib
    # CheckM2 (DIAMOND + ML) replaces legacy CheckM1: no pplacer/reference-tree,
    #   so no python 3.10 / setuptools<82 pins are needed and there is no ~40 GB
    #   RAM blow-up on placement. This env never imports ete3, so it does not
    #   need (and must NOT have) the python=3.12 pin above -- checkm2's newest
    #   build requires python>3.12, which is unsatisfiable with an exact ==3.12
    #   pin ("checkm2 =* * does not exist" is libmamba's way of saying no
    #   version of checkm2 satisfies both constraints at once).
    micromamba create --yes -n gather_genomes -c bioconda -c conda-forge checkm2 bbmap entrez-direct ncbi-datasets-cli pytest
    # Separate env for --annotator viral (VADR + VIGOR4 fallback). Kept apart
    #   from both base and gather_genomes on purpose: VADR pins its own
    #   infernal/hmmer/blast versions, different from base's -- installing it
    #   into a shared env is conda-resolvable but touches those shared package
    #   versions (same leak class as the earlier ReLeaf/mafft container
    #   env-leak incident). Tools here are reached only via control_file.paths'
    #   viral_env_run command prefix, never put on PATH alongside base. See
    #   orthophyl_viral_env.yml for the full pinned host-env equivalent.
    micromamba create --yes -n viral_annot -c bioconda -c conda-forge vadr exonerate openjdk diamond
    micromamba clean --all --yes
    chmod --recursive a+rw /opt/conda/bin/*
    chmod --recursive a+rw /opt/conda/envs/gather_genomes/bin
    chmod --recursive a+rw /opt/conda/envs/viral_annot/bin

%post
    # VIGOR4 (--annotator viral's fallback when no VADR model library
    #   classifies a genome): not a conda/bioconda package, so build it from
    #   source and unpack the resulting release layout (bin/vigor4 launcher,
    #   lib/*.jar, config/vigor.ini) into the viral_annot env, mirroring
    #   exactly what a host install does (see orthophyl_viral_env.yml).
    #   bin/vigor4 is self-locating (finds its own lib/*.jar and
    #   config/vigor.ini relative to its own resolved path), so it works
    #   unmodified from this install location.
    cd /opt
    git clone https://github.com/JCVenterInstitute/VIGOR4.git
    cd VIGOR4
    mvn package -DskipTests
    release_dir=$(find target -maxdepth 1 -type d -name "vigor-*" | head -1)
    mkdir -p /opt/conda/envs/viral_annot/opt/vigor4
    cp -r "$release_dir"/* /opt/conda/envs/viral_annot/opt/vigor4/
    ln -s /opt/conda/envs/viral_annot/opt/vigor4/bin/vigor4 /opt/conda/envs/viral_annot/bin/vigor4
    chmod --recursive a+rw /opt/conda/envs/viral_annot/opt/vigor4
    cd /opt
    rm -rf VIGOR4
    # VADR models (--vadr-models) and VIGOR_DB reference proteins
    #   (--vigor-db-dir) are deliberately NOT baked into the image here --
    #   both are supplied at runtime via bind-mounted host paths pointed at
    #   by those flags (viral_annotate.py's build_vigor_config() generates a
    #   correct VIGOR4 config from --vigor-db-dir on every run, so no default
    #   in-image DB location is needed). This differs from CheckM2's DB
    #   above, which is mandatory for every run and so is baked in via a
    #   required build-arg; VADR models/VIGOR_DB are optional/pluggable by
    #   virus family and a user is expected to bind-mount whichever ones
    #   their taxa need.

%post
    # TensorFlow's libtensorflow_cc.so.2 (pulled in by checkm2 -> keras) ships
    #   with an executable-stack ELF flag that some kernels refuse to mmap:
    #   "cannot enable executable stack as shared object requires: Invalid
    #   argument". This breaks `import checkm2` itself, before the DB download
    #   below ever runs. Clear the flag on every .so under the env's
    #   tensorflow package -- a no-op if the flag isn't set.
    find /opt/conda/envs/gather_genomes/lib/python3.12/site-packages/tensorflow \
        -name "*.so*" -exec patchelf --clear-execstack {} \;

    # CheckM2's DIAMOND reference database was staged from the HOST build
    #   machine by the %files section above (no network download here, by
    #   design -- see that section's comment). CHECKM2DB is exported in
    #   %environment below.
    #
    #   Verify it's a REAL, version-compatible DB rather than silently trusting
    #   whatever file the build host happened to have: hash it and check that
    #   hash against checkm2's OWN bundled manifest of known-good DIAMONDDB
    #   releases (version/version_hashes_<checkm2 version>.json, shipped
    #   inside the checkm2 package itself -- same file checkm2's own
    #   `checksum_version_validate()` uses internally). Fails the BUILD loudly
    #   if the staged file's hash isn't a known DIAMONDDB entry, or doesn't
    #   match the latest one for the installed checkm2 version -- catching a
    #   stale/wrong/truncated local copy here, not at pipeline runtime months
    #   later.
    staged_db_file=/opt/uniref100.KO.1.dmnd.staged
    if [ ! -s "$staged_db_file" ]; then
        echo "FATAL: CheckM2 DB not found at $staged_db_file -- the %files" >&2
        echo "  section's build-arg checkm2_db_path was likely not set. Build with:" >&2
        echo "  singularity build --build-arg checkm2_db_path=/path/to/uniref100.KO.1.dmnd ..." >&2
        exit 1
    fi
    mkdir -p /opt/checkm2_db/CheckM2_database
    mv "$staged_db_file" /opt/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd

    checkm2_py=/opt/conda/envs/gather_genomes/bin/python
    "$checkm2_py" <<'PYEOF'
import hashlib, json, os, sys
from checkm2.defaultValues import DefaultValues
from checkm2 import version
manifest_path = os.path.join(
    DefaultValues.VERSION_PATH, f'version_hashes_{version.__version__}.json')
db_path = "/opt/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd"

sha256 = hashlib.sha256()
with open(db_path, 'rb') as f:
    for block in iter(lambda: f.read(1 << 20), b''):
        sha256.update(block)
actual_hash = sha256.hexdigest()

with open(manifest_path) as f:
    manifest = json.load(f)
db_entries = [e for e in manifest if e['type'] == 'DIAMONDDB']
latest = max(db_entries, key=lambda e: int(e['version']))

matching = [e for e in db_entries if e['sha256'] == actual_hash]
if not matching:
    print(f"FATAL: staged CheckM2 DB sha256 {actual_hash} does not match "
          f"ANY known DIAMONDDB version in {manifest_path}.", file=sys.stderr)
    print(f"  Expected (latest, v{latest['version']}): {latest['sha256']}", file=sys.stderr)
    sys.exit(1)

matched = matching[0]
if matched['version'] != latest['version']:
    print(f"WARNING: staged CheckM2 DB is DIAMONDDB v{matched['version']}, "
          f"but checkm2 {version.__version__} ships manifest entries up to "
          f"v{latest['version']} (DOI {latest['DOI']}). Consider "
          f"refreshing the local copy with `checkm2 database --download`.",
          file=sys.stderr)
else:
    print(f"CheckM2 DB verified: DIAMONDDB v{matched['version']} "
          f"(DOI {matched['DOI']}), sha256 matches.")
PYEOF
    chmod --recursive a+rw /opt/checkm2_db

%post
    # edirect's `nquire` hardcodes `mktemp /tmp/NQUIRE_*.XXXX`, ignoring TMPDIR.
    #   Under Singularity the host /tmp is often read-only, so esearch fails with
    #   "mktemp: ... Read-only file system" then "curl: option -D: blank argument".
    #   Patch nquire to write scratch to $TMPDIR, falling back to $PWD (NOT /tmp):
    #   the image /tmp is read-only at runtime, but gather_filter_asms.sh always
    #   runs esearch with its CWD set to the (writable) output dir $wd, so $PWD is
    #   a guaranteed-writable fallback even if TMPDIR does not propagate.
    nquire_bin=/opt/conda/envs/gather_genomes/bin/nquire
    sed -i 's#mktemp /tmp/NQUIRE_#mktemp "${TMPDIR:-$PWD}"/NQUIRE_#g' "$nquire_bin"
    grep -qF 'mktemp "${TMPDIR:-$PWD}"/NQUIRE_' "$nquire_bin" \
        && echo "patched nquire to avoid read-only /tmp" \
        || echo "WARNING: nquire /tmp patch did not match -- check nquire version"

%post
    # make path to gits (duh)
    Path_to_gits=/opt/gits
    echo "Path_to_gits=/opt/gits" >> $SINGULARITY_ENVIRONMENT
    export PATH="/opt/conda/bin/:/opt/gits/OrthoPhyl/:/opt/miniconda3/bin/:$PATH"
    mkdir $Path_to_gits
    cd $Path_to_gits/

    # get ASTRAL
    git clone https://github.com/smirarab/ASTRAL.git
    cd ASTRAL
    unzip Astral.5.7.8.zip

    # get catfasta2phyml
    cd $Path_to_gits/
    git clone https://github.com/nylander/catfasta2phyml.git

    # get Alignemnt assessment and convert to python3
    git clone https://github.com/dportik/Alignment_Assessment.git
    cd Alignment_Assessment/
    # convert script to python3
    #/opt/conda/bin/2to3 -w Alignment_Assessment_v2.py


    # finally get OrthoPhyl
    cd $Path_to_gits
    git clone -b main https://github.com/eamiddlebrook/OrthoPhyl.git
    cd OrthoPhyl
    chmod a+rw OrthoPhyl.sh
    chmod a+rwx orthophyl_pipeline_wrapper.py
    chmod a+rwx /opt/gits/OrthoPhyl/assembly_router/*
    chmod a+rwx /opt/gits/OrthoPhyl/utils/*


    # do some final cleanup
    apt-get clean
    chmod --recursive a+rw $Path_to_gits

%environment
    export PATH="/opt/conda/bin/:/opt/conda/envs/gather_genomes/bin:/opt/gits/OrthoPhyl/:/opt/gits/OrthoPhyl/utils:/opt/gits/OrthoPhyl/assembly_router:/opt/miniconda3/bin/:$PATH"
    export Path_to_gits="/opt/gits"
    export OrthoPhyl="bash /opt/gits/OrthoPhyl/OrthoPhyl.sh"
    export orthophyl_pipeline_wrapper="python /opt/gits/OrthoPhyl/orthophyl_pipeline_wrapper.py"
    export assembly_router="python /opt/gits/OrthoPhyl/assembly_router/assembly_router.py"
    # CheckM2 DIAMOND DB (downloaded to /opt/checkm2_db in %post). CHECKM2DB
    #   must point at the .dmnd file itself.
    export CHECKM2DB="/opt/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd"
    export ASTRAL_cmd="$Path_to_gits/ASTRAL/Astral/astral.5.7.8.jar"
    export catfasta2phyml_cmd="$Path_to_gits/catfasta2phyml/catfasta2phyml.pl"
    export Alignment_Assessment="$Path_to_gits/Alignment_Assessment/Alignment_Assessment_v2.py"
    # --annotator viral's tools (v-annotate.pl, vigor4, diamond) live in the
    #   separate viral_annot env built above and are deliberately NOT added to
    #   PATH (see that %post block's comment) -- control_file.paths' host
    #   equivalent uses "conda run -n viral_annot"; this container uses
    #   micromamba instead. control_file.paths itself is NOT sourced in a
    #   container (guarded by $SINGULARITY_CONTAINER), so this export is the
    #   in-container source of truth for viral_env_run.
    export viral_env_run="micromamba run -n viral_annot"
    #stupid stuff for perl
    export LC_ALL=C.UTF-8 # Sets locale to UTF-8
    export LANG=C.UTF-8 # Sets locale to UTF-8


%runscript
    # Drop into an interactive shell by default. All OrthoPhyl entrypoints
    # (OrthoPhyl.sh, ReLeaf.sh, orthophyl_pipeline_wrapper.py) are on PATH,
    # so the container is used as an environment rather than a single command.
    echo "Container was created $NOW"
    echo "OrthoPhyl container -- entrypoints on PATH: OrthoPhyl.sh, ReLeaf.sh, orthophyl_pipeline_wrapper.py"
    echo "Starting interactive shell. Run 'singularity run OP.sif -h' style commands from inside, or exec directly (see %help)."
    exec /bin/bash

%help
    This container holds OrthoPhyl and all of its dependencies.
    The default runscript drops you into an interactive /bin/bash shell with
    every entrypoint already on PATH. You can either work interactively or
    exec a specific command via `singularity exec`.

    -- Python wrapper (recommended top-level entrypoint) --
    The orchestrator routes each assembly to ReLeaf (existing DB) or OrthoPhyl
    (novel taxon), managing databases and checkpoint/resume:

        apptainer exec OrthoPhyl.v3.3.sif \
            python /opt/gits/OrthoPhyl/orthophyl_pipeline_wrapper.py \
                --input assemblies.tsv \
                --database-dir databases/ \
                --output-dir results/ \
                --threads 32

    -- Core OrthoPhyl pipeline --
    Run directly on a directory of genome FASTAs:

        apptainer exec OrthoPhyl.v3.3.sif \
            bash /opt/gits/OrthoPhyl/OrthoPhyl.sh -g path/to/assemblies/ -s path/to/output/ -t 10

    Built-in test dataset:

        apptainer exec OrthoPhyl.v3.3.sif \
            bash /opt/gits/OrthoPhyl/OrthoPhyl.sh -T TESTER_chloroplast -s ./test_sing_chloroplast -t 10

    Help for the core pipeline:

        apptainer exec OrthoPhyl.v3.3.sif bash /opt/gits/OrthoPhyl/OrthoPhyl.sh -h

    -- Viral genome annotation (--annotator viral) --
    VADR (classification) and VIGOR4 (fallback) ship in this image, but VADR
    model libraries and the VIGOR_DB reference proteins do not -- bind-mount
    them from the host and point the flags at the mounted paths:

        apptainer exec --bind /host/vadr_models:/vadr_models,/host/VIGOR_DB:/vigor_db \
            OrthoPhyl.v3.3.sif \
            bash /opt/gits/OrthoPhyl/OrthoPhyl.sh -g path/to/viral_assemblies/ -s path/to/output/ \
                --annotator viral --vadr-models /vadr_models --vigor-db-dir /vigor_db -t 10

    -- Interactive session --
    To explore or run commands by hand (singularity exec/run are drop-in
    replacements for apptainer exec/run):

        apptainer run OrthoPhyl.v3.3.sif        # drops into /bin/bash
