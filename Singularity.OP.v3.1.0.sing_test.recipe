Bootstrap: docker
From: mambaorg/micromamba

%labels
AUTHOR earlm@lanl.gov

%post
    # save when the container was built
    NOW=`date`
    echo "export NOW=\"${NOW}\"" >> $SINGULARITY_ENVIRONMENT

    apt-get update
    apt-get install -y build-essential git
    apt-get install -y python3 pip libgl1
    apt-get install -y wget zip bc procps
    apt-get clean

%post
    # instal conda and conda packages
    # python=3.12 pinned to match orthophyl_env.2.2.1.yml's dev env -- ete3's
    #   webplugin submodule (imported unconditionally by ete3/__init__.py) does
    #   `import cgi`, which was removed from the stdlib in Python 3.13 (PEP 594).
    #   Without this pin, micromamba resolves whatever the latest Python is at
    #   build time, silently breaking every `import ete3` in the pipeline.
    micromamba install --yes --name base --channel bioconda --channel conda-forge python=3.12 prodigal orthofinder=2.5.4 bbmap=39.01 fasttree hmmer mash prodigal ete3 raxml trimal r-essentials scipy iqtree pytest
    # CheckM2 (DIAMOND + ML) replaces legacy CheckM1: no pplacer/reference-tree,
    #   so no python 3.10 / setuptools<82 pins are needed and there is no ~40 GB
    #   RAM blow-up on placement. This env never imports ete3, so it does not
    #   need (and must NOT have) the python=3.12 pin above -- checkm2's newest
    #   build requires python>3.12, which is unsatisfiable with an exact ==3.12
    #   pin ("checkm2 =* * does not exist" is libmamba's way of saying no
    #   version of checkm2 satisfies both constraints at once).
    micromamba create --yes -n gather_genomes -c bioconda -c conda-forge checkm2 bbmap entrez-direct ncbi-datasets-cli pytest
    micromamba clean --all --yes
    chmod --recursive a+rw /opt/conda/bin/*
    chmod --recursive a+rw /opt/conda/envs/gather_genomes/bin

%post
    # CheckM2 needs its DIAMOND reference database unpacked to a fixed location.
    #   Baked into the image so no runtime download is required.
    #   CHECKM2DB is exported in %environment below.
    mkdir -p /opt/checkm2_db
    /opt/conda/envs/gather_genomes/bin/checkm2 database --download --path /opt/checkm2_db
    chmod --recursive a+rw /opt/checkm2_db

%post
    # edirect's `nquire` hardcodes `mktemp /tmp/NQUIRE_*.XXXX`, ignoring TMPDIR.
    #   Under Singularity the host /tmp is often read-only, so esearch fails with
    #   "mktemp: ... Read-only file system" then "curl: option -D: blank argument".
    #   Patch nquire to write scratch to $TMPDIR, falling back to $PWD (NOT /tmp):
    #   the image /tmp is read-only at runtime, but gather_filter_asms.sh always
    #   runs esearch with its CWD set to the (writable) output dir $wd, so $PWD is
    #   a guaranteed-writable fallback even if TMPDIR does not propagate.
    nquire_bin=/opt/conda/envs/gather_genomes/bin/nquire
    sed -i 's#mktemp /tmp/NQUIRE_#mktemp "${TMPDIR:-$PWD}"/NQUIRE_#g' "$nquire_bin"
    grep -qF 'mktemp "${TMPDIR:-$PWD}"/NQUIRE_' "$nquire_bin" \
        && echo "patched nquire to avoid read-only /tmp" \
        || echo "WARNING: nquire /tmp patch did not match -- check nquire version"

%post
    # make path to gits (duh)
    Path_to_gits=/opt/gits
    echo "Path_to_gits=/opt/gits" >> $SINGULARITY_ENVIRONMENT
    export PATH="/opt/conda/bin/:/opt/gits/OrthoPhyl/:/opt/miniconda3/bin/:$PATH"
    mkdir $Path_to_gits
    cd $Path_to_gits/

    # get ASTRAL
    git clone https://github.com/smirarab/ASTRAL.git
    cd ASTRAL
    unzip Astral.5.7.8.zip

    # get catfasta2phyml
    cd $Path_to_gits/
    git clone https://github.com/nylander/catfasta2phyml.git

    # get Alignemnt assessment and convert to python3
    git clone https://github.com/dportik/Alignment_Assessment.git
    cd Alignment_Assessment/
    # convert script to python3
    #/opt/conda/bin/2to3 -w Alignment_Assessment_v2.py


    # finally get OrthoPhyl
    cd $Path_to_gits
    git clone -b sing_test https://github.com/eamiddlebrook/OrthoPhyl.git
    cd OrthoPhyl
    chmod a+rw OrthoPhyl.sh
    chmod a+rwx orthophyl_pipeline_wrapper.py
    chmod a+rwx /opt/gits/OrthoPhyl/assembly_router/*
    chmod a+rwx /opt/gits/OrthoPhyl/utils/*


    # do some final cleanup
    apt-get clean
    chmod --recursive a+rw $Path_to_gits

%environment
    export PATH="/opt/conda/bin/:/opt/conda/envs/gather_genomes/bin:/opt/gits/OrthoPhyl/:/opt/gits/OrthoPhyl/utils:/opt/gits/OrthoPhyl/assembly_router:/opt/miniconda3/bin/:$PATH"
    export Path_to_gits="/opt/gits"
    export OrthoPhyl="bash /opt/gits/OrthoPhyl/OrthoPhyl.sh"
    export orthophyl_pipeline_wrapper="python /opt/gits/OrthoPhyl/orthophyl_pipeline_wrapper.py"
    export assembly_router="python /opt/gits/OrthoPhyl/assembly_router/assembly_router.py"
    # CheckM2 DIAMOND DB (downloaded to /opt/checkm2_db in %post). CHECKM2DB
    #   must point at the .dmnd file itself.
    export CHECKM2DB="/opt/checkm2_db/CheckM2_database/uniref100.KO.1.dmnd"
    export ASTRAL_cmd="$Path_to_gits/ASTRAL/Astral/astral.5.7.8.jar"
    export catfasta2phyml_cmd="$Path_to_gits/catfasta2phyml/catfasta2phyml.pl"
    export Alignment_Assessment="$Path_to_gits/Alignment_Assessment/Alignment_Assessment_v2.py"
    #stupid stuff for perl
    export LC_ALL=C.UTF-8 # Sets locale to UTF-8
    export LANG=C.UTF-8 # Sets locale to UTF-8


%runscript
    # Drop into an interactive shell by default. All OrthoPhyl entrypoints
    # (OrthoPhyl.sh, ReLeaf.sh, orthophyl_pipeline_wrapper.py) are on PATH,
    # so the container is used as an environment rather than a single command.
    echo "Container was created $NOW"
    echo "OrthoPhyl container -- entrypoints on PATH: OrthoPhyl.sh, ReLeaf.sh, orthophyl_pipeline_wrapper.py"
    echo "Starting interactive shell. Run 'singularity run OP.sif -h' style commands from inside, or exec directly (see %help)."
    exec /bin/bash

%help
    This container holds OrthoPhyl and all of its dependencies.
    The default runscript drops you into an interactive /bin/bash shell with
    every entrypoint already on PATH. You can either work interactively or
    exec a specific command via `singularity exec`.

    -- Python wrapper (recommended top-level entrypoint) --
    The orchestrator routes each assembly to ReLeaf (existing DB) or OrthoPhyl
    (novel taxon), managing databases and checkpoint/resume:

        singularity exec OrthoPhyl.3.1.0.sif \
            python /opt/gits/OrthoPhyl/orthophyl_pipeline_wrapper.py \
                --input assemblies.tsv \
                --database-dir databases/ \
                --output-dir results/ \
                --threads 32

    -- Core OrthoPhyl pipeline --
    Run directly on a directory of genome FASTAs:

        singularity exec OrthoPhyl.3.1.0.sif \
            bash /opt/gits/OrthoPhyl/OrthoPhyl.sh -g path/to/assemblies/ -s path/to/output/ -t 10

    Built-in test dataset:

        singularity exec OrthoPhyl.3.1.0.sif \
            bash /opt/gits/OrthoPhyl/OrthoPhyl.sh -T TESTER_chloroplast -s ./test_sing_chloroplast -t 10

    Help for the core pipeline:

        singularity exec OrthoPhyl.3.1.0.sif bash /opt/gits/OrthoPhyl/OrthoPhyl.sh -h

    -- Interactive session --
    To explore or run commands by hand:

        singularity run OrthoPhyl.3.1.0.sif        # drops into /bin/bash
